<?xml version="1.0" encoding="utf-8"?><!--
   备份规则(API 30 及以下 / fullBackupContent)。

   默认全量备份会把 App 的全部 SharedPreferences 带走,其中 xiangsu_auth 存着
   30 天有效的 Bearer token —— 一旦随云备份恢复到别的设备,等于把登录态送出去。
   这里显式排除;API 31+ 的等价规则见 data_extraction_rules.xml。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="xiangsu_auth.xml" />
</full-backup-content>
