<?xml version="1.0" encoding="utf-8"?><!--
   数据提取规则(API 31+):云备份与设备间迁移分别配置。

   xiangsu_auth 里存着 30 天有效的登录令牌,不应随备份/换机迁移到别的设备。
   旧系统的等价规则见 backup_rules.xml。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="xiangsu_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="xiangsu_auth.xml" />
    </device-transfer>
</data-extraction-rules>
